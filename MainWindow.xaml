<Window x:Class="McuFlasher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STM32 / GD32 烧录工具" Height="690" Width="840" MinHeight="650" MinWidth="700"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#162B3F" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,4"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="STM32 / GD32 烧录工具" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16">
            <Grid x:Name="SettingsPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="下载器" Target="{Binding ElementName=ProbeBox}"/>
                <StackPanel x:Name="ProbeSettings" Grid.Column="1" Orientation="Horizontal">
                    <ComboBox x:Name="ProbeBox" Width="122" VerticalAlignment="Center"
                              SelectionChanged="SelectionChanged">
                        <ComboBoxItem Content="J-Link"/>
                        <ComboBoxItem Content="ST-LINK"/>
                    </ComboBox>
                    <Label Content="SWD 速率（kHz）" Margin="24,0,8,0" Target="{Binding ElementName=SpeedBox}"/>
                    <ComboBox x:Name="SpeedBox" Width="72" VerticalAlignment="Center" SelectedIndex="2">
                        <ComboBoxItem Content="100"/>
                        <ComboBoxItem Content="400"/>
                        <ComboBoxItem Content="1000"/>
                        <ComboBoxItem Content="4000"/>
                    </ComboBox>
                </StackPanel>
                <Label Grid.Row="1" Content="目标芯片" Target="{Binding ElementName=TargetBox}"/>
                <StackPanel x:Name="TargetSettings" Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <ComboBox x:Name="FamilyBox" Width="122" VerticalAlignment="Center"
                              SelectionChanged="FamilyChanged" AutomationProperties.Name="芯片系列"/>
                    <ComboBox x:Name="TargetBox" Width="174" Margin="8,0,0,0" VerticalAlignment="Center"
                              SelectionChanged="SelectionChanged"/>
                    <TextBlock x:Name="CapacityText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#50657A"/>
                </StackPanel>
                <Label Grid.Row="2" Content="固件文件" Target="{Binding ElementName=FirmwareBox}"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="FirmwareBox" Height="30"
                         TextChanged="FirmwareChanged" AllowDrop="True" PreviewDragOver="FirmwareDragOver" PreviewDrop="FirmwareDrop"/>
                <Button Grid.Row="2" Grid.Column="2" Content="选择文件…" Click="ChooseFirmware" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <Label Grid.Row="3" Content="BIN 起始地址" Target="{Binding ElementName=AddressBox}"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <TextBox x:Name="AddressBox" Width="122" Height="30" Text="0x08000000"/>
                    <CheckBox x:Name="ResetBox" Content="校验后复位运行" VerticalAlignment="Center"
                              IsChecked="True" Margin="24,0,0,0"/>
                </StackPanel>
                <Label Grid.Row="4" x:Name="ToolLabel" Content="烧录工具" Target="{Binding ElementName=ToolBox}"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="ToolBox" Height="30" TextChanged="ToolChanged"/>
                <StackPanel x:Name="ToolActions" Grid.Row="4" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="选择工具…" Click="ChooseTool" Margin="8,0,0,0"/>
                    <Button x:Name="InstallToolButton" Content="下载工具…" Click="InstallTool" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,9,0,0">
                    <Button x:Name="ConnectButton" Content="连接芯片" Click="ConnectChip" Padding="16,6"/>
                    <Button x:Name="FlashButton" Content="烧录并校验" Click="Flash" FontWeight="SemiBold"
                            Padding="24,6" Margin="10,0,0,0" Background="#D8E9FC"/>
                    <TextBlock x:Name="ConnectionText" Text="未连接" VerticalAlignment="Center"
                               Foreground="#50657A" Margin="14,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="清空日志" Click="ClearLog"/>
                <Button DockPanel.Dock="Right" x:Name="AiDebugButton" Content="AI 调试接入…"
                        Click="ToggleAiDebug" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Text="请选择目标芯片和固件" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </DockPanel>
            <ProgressBar x:Name="ActivityBar" Grid.Row="1" Height="4" Margin="0,0,0,7" Visibility="Collapsed"/>
            <TabControl Grid.Row="2" x:Name="OpsTabs">
                <TabItem Header="日志">
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10"
                             Background="#132639" Foreground="#E0ECF7" CaretBrush="#E0ECF7"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="13"
                             AutomationProperties.Name="烧录日志"/>
                </TabItem>
                <TabItem Header="按页擦除">
                    <DockPanel x:Name="ErasePanel" IsEnabled="False" Margin="8">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="擦除选中页…" Click="ErasePages"/>
                            <TextBlock x:Name="EraseHint" Text="连接芯片后显示 Flash 页表" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid x:Name="SectorGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" EnableRowVirtualization="True" SelectionMode="Single"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="选择" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Bank" Binding="{Binding Bank}" Width="60" IsReadOnly="True"/>
                                <DataGridTextColumn Header="页／扇区" Binding="{Binding Index}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="起始地址" Binding="{Binding Address}" Width="135" IsReadOnly="True"/>
                                <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="95" IsReadOnly="True"/>
                                <DataGridTextColumn Header="区域" Binding="{Binding Area}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
